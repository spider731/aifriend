# ========== 必填 ==========
# Anthropic API Key（从 https://console.anthropic.com 获取）
ANTHROPIC_API_KEY=sk-ant-...

# ========== 可选 ==========
# 服务器端口
PORT=3000

# Claude 模型
CLAUDE_MODEL=claude-sonnet-4-6-20250514

# 她的名字
GF_NAME=小七

# 作息时间
GF_WAKE_TIME=08:30
GF_SLEEP_TIME=23:00

# 时区
TZ=Asia/Shanghai

# Web Push VAPID 密钥（可选，不设则自动生成）
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
